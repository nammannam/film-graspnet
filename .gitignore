# Keep the repository focused: ignore every top-level directory by default.
/*/

# Version-controlled project directories.
!/configs/
!/figures/
!/scripts/
!/splits/
!/src/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example
!.env.sample
.aws/

# Test, type-checker, and notebook caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Local editor and OS files (also covered by the top-level allowlist).
.idea/
.vscode/
.DS_Store
Thumbs.db
